{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "node"
    ]
  },
  "include": [
    "src",
    "e2e",
    "playwright.config.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "src/sw.ts"
  ]
}
