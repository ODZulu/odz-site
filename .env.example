# Copy to .env.local and fill in. Never commit real values.
# Anything prefixed VITE_ ships to the browser. Only the anon/publishable key belongs here.
# The service_role / secret key must NEVER go in a VITE_ variable or in this repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
